@prefix dq: <http://example.org/dq#> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

dq:dim-accessibility a skos:Concept,
        dqv:Dimension ;
    skos:definition "Puede acceder a él quien lo necesita, incluidas personas con necesidades especiales."@es ;
    skos:prefLabel "Accessibility"@en,
        "Accesibilidad"@es ;
    dqv:inCategory dq:cat-inherente,
        dq:cat-sistema .

dq:dim-accuracy a skos:Concept,
        dqv:Dimension ;
    skos:definition "El dato representa correctamente el valor real del atributo que describe."@es ;
    skos:prefLabel "Accuracy"@en,
        "Exactitud"@es ;
    dqv:inCategory dq:cat-inherente .

dq:dim-availability a skos:Concept,
        dqv:Dimension ;
    skos:definition "Está disponible y se puede recuperar cuando se necesita."@es ;
    skos:prefLabel "Availability"@en,
        "Disponibilidad"@es ;
    dqv:inCategory dq:cat-sistema .

dq:dim-completeness a skos:Concept,
        dqv:Dimension ;
    skos:definition "Existen valores para todos los atributos y entidades esperados."@es ;
    skos:prefLabel "Completeness"@en,
        "Completitud"@es ;
    dqv:inCategory dq:cat-inherente .

dq:dim-compliance a skos:Concept,
        dqv:Dimension ;
    skos:definition "Cumple las normas, convenciones y regulaciones aplicables."@es ;
    skos:prefLabel "Compliance"@en,
        "Conformidad"@es ;
    dqv:inCategory dq:cat-inherente,
        dq:cat-sistema .

dq:dim-confidentiality a skos:Concept,
        dqv:Dimension ;
    skos:definition "Solo accede a él quien está autorizado."@es ;
    skos:prefLabel "Confidentiality"@en,
        "Confidencialidad"@es ;
    dqv:inCategory dq:cat-inherente,
        dq:cat-sistema .

dq:dim-consistency a skos:Concept,
        dqv:Dimension ;
    skos:definition "El dato no se contradice y es coherente con otros datos de su contexto."@es ;
    skos:prefLabel "Consistency"@en,
        "Consistencia"@es ;
    dqv:inCategory dq:cat-inherente .

dq:dim-credibility a skos:Concept,
        dqv:Dimension ;
    skos:definition "Quienes lo usan lo consideran cierto y creíble."@es ;
    skos:prefLabel "Credibility"@en,
        "Credibilidad"@es ;
    dqv:inCategory dq:cat-inherente .

dq:dim-currentness a skos:Concept,
        dqv:Dimension ;
    skos:definition "El dato tiene la edad adecuada para el uso previsto."@es ;
    skos:prefLabel "Currentness"@en,
        "Actualidad"@es ;
    dqv:inCategory dq:cat-inherente .

dq:dim-efficiency a skos:Concept,
        dqv:Dimension ;
    skos:definition "Se puede procesar con las prestaciones adecuadas y recursos razonables."@es ;
    skos:prefLabel "Efficiency"@en,
        "Eficiencia"@es ;
    dqv:inCategory dq:cat-inherente,
        dq:cat-sistema .

dq:dim-portability a skos:Concept,
        dqv:Dimension ;
    skos:definition "Se puede instalar, sustituir o mover entre sistemas conservando su calidad."@es ;
    skos:prefLabel "Portability"@en,
        "Portabilidad"@es ;
    dqv:inCategory dq:cat-sistema .

dq:dim-precision a skos:Concept,
        dqv:Dimension ;
    skos:definition "Tiene el nivel de detalle que requiere su uso."@es ;
    skos:prefLabel "Precision"@en,
        "Precisión"@es ;
    dqv:inCategory dq:cat-inherente,
        dq:cat-sistema .

dq:dim-recoverability a skos:Concept,
        dqv:Dimension ;
    skos:definition "Mantiene el nivel de calidad incluso ante fallos."@es ;
    skos:prefLabel "Recoverability"@en,
        "Recuperabilidad"@es ;
    dqv:inCategory dq:cat-sistema .

dq:dim-traceability a skos:Concept,
        dqv:Dimension ;
    skos:definition "Se puede auditar quién lo accedió o modificó y de dónde procede."@es ;
    skos:prefLabel "Traceability"@en,
        "Trazabilidad"@es ;
    dqv:inCategory dq:cat-inherente,
        dq:cat-sistema .

dq:dim-understandability a skos:Concept,
        dqv:Dimension ;
    skos:definition "Los usuarios pueden leerlo e interpretarlo (lenguaje, símbolos, unidades)."@es ;
    skos:prefLabel "Understandability"@en,
        "Comprensibilidad"@es ;
    dqv:inCategory dq:cat-inherente,
        dq:cat-sistema .

dq:cat-sistema a skos:Concept,
        dqv:Category ;
    skos:prefLabel "System-dependent data quality (ISO/IEC 25012)"@en,
        "Calidad dependiente del sistema"@es .

dq:cat-inherente a skos:Concept,
        dqv:Category ;
    skos:prefLabel "Inherent data quality (ISO/IEC 25012)"@en,
        "Calidad inherente al dato"@es .


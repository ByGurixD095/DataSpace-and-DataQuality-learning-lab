@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix dc:   <http://purl.org/dc/elements/1.1/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:   <http://example.org/> .

# ============================================================
# 📜 ANTES — Modelo de metadatos NTI-RISP (2013)
# El catálogo de calidad del aire, tal y como se describía
# antes de DCAT-AP-ES. Compáralo con ejemplo-dcat-ap-es.ttl.
#
# Fíjate en lo que DESAPARECE o CAMBIA en el nuevo perfil:
#   ⚠️ dc:language con literales ("es", "en")
#   ⚠️ la licencia vive en el dataset
#   ⚠️ el formato es un nodo dct:IMT con texto
#   ⚠️ la cobertura temporal usa time:Interval
#   ⚠️ no hay servicios de datos ni punto de contacto
#
# (El código E0DAT0001 es el de ejemplo de la guía oficial;
#  en un catálogo real iría el código DIR3 del organismo.)
# ============================================================

ex:catalogo
    a dcat:Catalog ;
    dct:title "Catálogo de datos abiertos del Ayuntamiento"@es ,
              "Open data catalogue of the City Council"@en ;
    dct:description "Catálogo de datos abiertos del Ayuntamiento de Ejemplo."@es ,
                    "Open data catalogue of the Example City Council."@en ;
    foaf:homepage <http://example.org> ;
    dct:publisher <http://datos.gob.es/recurso/sector-publico/org/Organismo/E0DAT0001> ;
    dcat:themeTaxonomy <http://datos.gob.es/kos/sector-publico/sector> ;
    dct:issued   "2026-01-15T09:00:00+01:00"^^xsd:dateTime ;
    dct:modified "2026-10-01T12:00:00+02:00"^^xsd:dateTime ;

    dc:language "es" , "en" ;                                   # ⚠️ literales y dc:

    dct:spatial <http://datos.gob.es/recurso/sector-publico/territorio/Pais/España> ;
    dct:license <http://publications.europa.eu/resource/authority/licence/CC_BY_4_0> ;
    dcat:dataset ex:dataset-calidad-aire .

ex:dataset-calidad-aire
    a dcat:Dataset ;
    dct:identifier "http://example.org/dataset-calidad-aire" ;
    dct:title "Calidad del aire"@es , "Air quality"@en ;
    dct:description "Mediciones horarias de contaminantes atmosféricos (NO2, PM10, PM2.5, O3) de la red de estaciones municipal."@es ,
                    "Hourly measurements of air pollutants (NO2, PM10, PM2.5, O3) from the municipal station network."@en ;
    dct:publisher <http://datos.gob.es/recurso/sector-publico/org/Organismo/E0DAT0001> ;
    dcat:theme <http://datos.gob.es/kos/sector-publico/sector/medio-ambiente> ;
    dct:spatial <http://datos.gob.es/recurso/sector-publico/territorio/Pais/España> ;
    dcat:keyword "calidad del aire"@es , "air quality"@en ;

    dct:license <http://publications.europa.eu/resource/authority/licence/CC_BY_4_0> ;   # ⚠️ licencia en el dataset

    dc:language "es" , "en" ;                                   # ⚠️ literales y dc:

    # ⚠️ Cobertura temporal con la ontología Time
    dct:temporal [
        a time:Interval , dct:PeriodOfTime ;
        time:hasBeginning [
            a time:Instant ;
            time:inXSDDateTime "2021-01-01T00:00:00"^^xsd:dateTime
        ] ;
        time:hasEnd [
            a time:Instant ;
            time:inXSDDateTime "2025-12-31T00:00:00"^^xsd:dateTime
        ]
    ] ;

    dcat:distribution ex:distribucion-calidad-aire-csv .

ex:distribucion-calidad-aire-csv
    a dcat:Distribution ;
    dct:title "Calidad del aire (CSV)"@es , "Air quality (CSV)"@en ;
    dct:description "Fichero CSV con las mediciones horarias."@es ;
    dcat:accessURL <http://example.org/files/calidad-aire.csv> ;

    # ⚠️ Formato como nodo dct:IMT con texto
    dct:format [
        a dct:IMT ;
        rdf:value "text/csv" ;
        rdfs:label "CSV"
    ] ;

    dcat:byteSize "1024"^^xsd:nonNegativeInteger .

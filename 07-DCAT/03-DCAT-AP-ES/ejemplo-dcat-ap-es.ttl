@prefix dcat:   <http://www.w3.org/ns/dcat#> .
@prefix dcatap: <http://data.europa.eu/r5r/> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix foaf:   <http://xmlns.com/foaf/0.1/> .
@prefix odrl:   <http://www.w3.org/ns/odrl/2/> .
@prefix vcard:  <http://www.w3.org/2006/vcard/ns#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:     <http://example.org/> .

# ============================================================
# 🇪🇸 DESPUÉS — DCAT-AP-ES
# El mismo catálogo de ejemplo-nti-risp-2013.ttl, migrado.
#
# Marcas:
#   🔧 ajuste mínimo de la migración
#   ➕ ampliación recomendada (no obligatoria para federar)
#
# (El código E0DAT0001 es el de ejemplo de la guía oficial;
#  en un catálogo real iría el código DIR3 del organismo.
#  Comprueba también los vocabularios exigidos en la guía técnica.)
# ============================================================

# 📚 El catálogo
ex:catalogo
    a dcat:Catalog ;
    dct:title "Catálogo de datos abiertos del Ayuntamiento"@es ,
              "Open data catalogue of the City Council"@en ;
    dct:description "Catálogo de datos abiertos del Ayuntamiento de Ejemplo."@es ,
                    "Open data catalogue of the Example City Council."@en ;
    foaf:homepage <http://example.org> ;
    dct:publisher <http://datos.gob.es/recurso/sector-publico/org/Organismo/E0DAT0001> ;
    dcat:themeTaxonomy <http://datos.gob.es/kos/sector-publico/sector> ;
    dct:issued   "2026-01-15T09:00:00+01:00"^^xsd:dateTime ;
    dct:modified "2026-10-01T12:00:00+02:00"^^xsd:dateTime ;

    # 🔧 dc:language "es" → dct:language con URIs de la lista europea
    dct:language <http://publications.europa.eu/resource/authority/language/SPA> ,
                 <http://publications.europa.eu/resource/authority/language/ENG> ;

    dct:spatial <http://datos.gob.es/recurso/sector-publico/territorio/Pais/España> ;
    dct:license <http://publications.europa.eu/resource/authority/licence/CC_BY_4_0> ;
    dcat:dataset ex:dataset-calidad-aire ;
    dcat:service ex:api-calidad-aire .                          # ➕ servicio de datos


# 🗃️ El dataset
ex:dataset-calidad-aire
    a dcat:Dataset ;
    dct:identifier "http://example.org/dataset-calidad-aire" ;  # 🔧 identificador estable
    dct:title "Calidad del aire"@es , "Air quality"@en ;
    dct:description "Mediciones horarias de contaminantes atmosféricos (NO2, PM10, PM2.5, O3) de la red de estaciones municipal."@es ,
                    "Hourly measurements of air pollutants (NO2, PM10, PM2.5, O3) from the municipal station network."@en ;
    dct:publisher <http://datos.gob.es/recurso/sector-publico/org/Organismo/E0DAT0001> ;

    # 🏷️ Taxonomías españolas
    dcat:theme <http://datos.gob.es/kos/sector-publico/sector/medio-ambiente> ;
    dct:spatial <http://datos.gob.es/recurso/sector-publico/territorio/Pais/España> ;

    dcat:keyword "calidad del aire"@es , "air quality"@en ;
    dct:language <http://publications.europa.eu/resource/authority/language/SPA> ;   # 🔧 URI, no literal
    dct:accrualPeriodicity <http://publications.europa.eu/resource/authority/frequency/DAILY> ;

    # 🗺️ Cobertura temporal: dct:PeriodOfTime con startDate/endDate (sin time:Interval)
    dct:temporal [
        a dct:PeriodOfTime ;
        dcat:startDate "2021-01-01T00:00:00Z"^^xsd:dateTime ;
        dcat:endDate   "2025-12-31T00:00:00Z"^^xsd:dateTime
    ] ;

    # ➕ Ampliaciones del dataset
    dcat:contactPoint ex:contacto ;
    dcat:landingPage <http://example.org/datos/calidad-aire> ;
    dct:accessRights <http://publications.europa.eu/resource/authority/access-right/PUBLIC> ;
    dcat:version "1.0" ;
    dcat:temporalResolution "PT1H"^^xsd:duration ;              # mediciones horarias

    # (Solo si el dataset fuera de alto valor — ver bloque HVD al final)

    dcat:distribution ex:distribucion-calidad-aire-csv .        # 🔧 al menos una distribución


# 📄 La distribución
ex:distribucion-calidad-aire-csv
    a dcat:Distribution ;
    dct:title "Calidad del aire (CSV)"@es , "Air quality (CSV)"@en ;
    dct:description "Fichero CSV con las mediciones horarias."@es ;
    dcat:accessURL <http://example.org/files/calidad-aire.csv> ;      # 🔧 obligatoria
    dcat:downloadURL <http://example.org/files/calidad-aire.csv> ;    # ➕ descarga directa

    # Formato: URI del vocabulario europeo + tipo MIME de IANA (ya no un nodo dct:IMT)
    dct:format <http://publications.europa.eu/resource/authority/file-type/CSV> ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/text/csv> ;

    # 🔧 La licencia se declara AQUÍ, en la distribución
    dct:license <http://publications.europa.eu/resource/authority/licence/CC_BY_4_0> ;

    dcatap:availability <http://publications.europa.eu/resource/authority/planned-availability/STABLE> ;  # ➕
    dcat:byteSize "1024"^^xsd:nonNegativeInteger ;
    dcat:accessService ex:api-calidad-aire ;                    # ➕ servicio que da acceso

    # 🛡️ ➕ Política de uso en ODRL (la Offer del README de 06-ODRL)
    odrl:hasPolicy ex:oferta-calidad-aire .


# 🔌 ➕ El servicio de datos
ex:api-calidad-aire
    a dcat:DataService ;
    dct:title "API de calidad del aire"@es ;                              # obligatoria
    dcat:endpointURL <http://example.org/api/calidad-aire> ;              # obligatoria
    dcat:theme <http://datos.gob.es/kos/sector-publico/sector/medio-ambiente> ;   # obligatoria
    dct:publisher <http://datos.gob.es/recurso/sector-publico/org/Organismo/E0DAT0001> ;  # obligatoria
    dcat:endpointDescription <http://example.org/api/calidad-aire/docs> ;
    dcat:keyword "calidad del aire"@es ;
    dcat:contactPoint ex:contacto ;
    dcat:servesDataset ex:dataset-calidad-aire .


# ☎️ ➕ El punto de contacto (institucional y persistente)
ex:contacto
    a vcard:Organization ;
    vcard:organization-name "Ayuntamiento de Ejemplo"@es ;
    vcard:fn "Oficina del dato"@es ;
    vcard:hasUID <http://datos.gob.es/recurso/sector-publico/org/Organismo/E0DAT0001> ;
    vcard:hasEmail <mailto:datos@example.org> ;
    vcard:hasURL <http://example.org/> .


# ============================================================
# 🛡️ Política ODRL referenciada (definida en 06-ODRL)
# Se incluye una versión mínima para que el grafo sea autocontenido.
# ============================================================

ex:oferta-calidad-aire
    a odrl:Offer ;
    odrl:uid ex:oferta-calidad-aire ;
    odrl:assigner <http://datos.gob.es/recurso/sector-publico/org/Organismo/E0DAT0001> ;
    odrl:permission [
        odrl:target ex:dataset-calidad-aire ;
        odrl:action odrl:use
    ] .


# ============================================================
# 🌟 BLOQUE HVD (comentado) — solo si el dataset fuera de alto valor
# Reglamento de ejecución (UE) 2023/138.
# Requiere además: descarga masiva, servicio de datos y contacto.
# Comprueba la URI de la categoría en la taxonomía oficial HVD:
# la de abajo es la que aparece en el ejemplo de la guía oficial
# y NO se ha verificado que corresponda a este dataset.
# ============================================================
#
# ex:dataset-calidad-aire
#     dcatap:applicableLegislation <http://data.europa.eu/eli/reg_impl/2023/138/oj> ;
#     dcatap:hvdCategory <http://data.europa.eu/bna/c_b7f6a4f3> .
#
# ex:distribucion-calidad-aire-csv
#     dcatap:applicableLegislation <http://data.europa.eu/eli/reg_impl/2023/138/oj> .
#
# ex:api-calidad-aire
#     dcatap:applicableLegislation <http://data.europa.eu/eli/reg_impl/2023/138/oj> ;
#     dcatap:hvdCategory <http://data.europa.eu/bna/c_b7f6a4f3> ;
#     foaf:page <http://example.org/api/calidad-aire/sla.html> .
